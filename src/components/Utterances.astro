---
interface Props {
  issueNumber: number;
}

const { issueNumber } = Astro.props;
---

<section class="comments-section" aria-labelledby="comments-title" data-pagefind-ignore>
  <div class="section-kicker">Discussion</div>
  <h2 id="comments-title">讨论</h2>
  <p>评论存储在对应的 GitHub Issue 中。</p>
  <button class="load-comments" type="button" data-issue-number={issueNumber}>加载评论</button>
  <div class="comments-root" aria-live="polite"></div>
</section>

<script>
  const button = document.querySelector<HTMLButtonElement>(".load-comments");
  const root = document.querySelector<HTMLDivElement>(".comments-root");

  button?.addEventListener("click", () => {
    if (!root || root.dataset.loaded === "true") return;

    root.dataset.loaded = "true";
    button.disabled = true;
    button.textContent = "正在加载…";

    const script = document.createElement("script");
    script.src = "https://utteranc.es/client.js";
    script.async = true;
    script.crossOrigin = "anonymous";
    script.setAttribute("repo", "kwu130/kwu130.github.io");
    script.setAttribute("issue-number", button.dataset.issueNumber ?? "");
    script.setAttribute(
      "theme",
      document.documentElement.dataset.theme === "dark" ? "github-dark" : "github-light"
    );
    script.addEventListener("load", () => button.remove());
    script.addEventListener("error", () => {
      button.disabled = false;
      button.textContent = "加载失败，点击重试";
      root.dataset.loaded = "false";
    });
    root.appendChild(script);
  });
</script>

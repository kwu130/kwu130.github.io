---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts, getTagCounts, tagHref } from "../../lib/posts";

const posts = await getPublishedPosts();
const tags = getTagCounts(posts);
---

<BaseLayout title="标签" description="按主题浏览 Wukai’s Lab 的技术文章。">
  <section class="tags-page">
    <div class="section-kicker">Topics</div>
    <h1>主题标签</h1>
    <p>从工具到运行时，从主机代码到设备代码，按主题查找所有文章。</p>
    <div class="tag-grid">
      {[...tags].map(([tag, count]) => (
        <a class="tag-tile" href={tagHref(tag)}>
          <strong>#{tag}</strong>
          <span>{String(count).padStart(2, "0")} 篇文章</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

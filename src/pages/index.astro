---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getPublishedPosts, getTagCounts, tagHref } from "../lib/posts";
import { SITE } from "../lib/site";

const posts = await getPublishedPosts();
const tags = getTagCounts(posts);
---

<BaseLayout>
  <section class="shell home-hero" data-pagefind-ignore>
    <div>
      <div class="eyebrow">Independent engineering notes · Est. 2024</div>
      <h1>拆解代码<br />背后的<em>细节</em></h1>
      <p class="home-lede">
        {SITE.description}。记录可复现的实验、工具使用方法，以及那些值得被解释清楚的工程边界。
      </p>
    </div>
    <aside class="hero-note">
      <strong>Current focus</strong>
      C++ runtime / CUDA device code / developer tooling
    </aside>
  </section>

  <section class="shell content-section" aria-labelledby="latest-heading">
    <div class="section-head">
      <div>
        <div class="section-kicker">Journal</div>
        <h2 id="latest-heading">最新文章</h2>
      </div>
      <a class="section-link" href="/rss.xml">订阅 RSS →</a>
    </div>
    <div class="post-list">
      {posts.map((post, index) => <PostCard post={post} index={index} />)}
    </div>
  </section>

  <section class="shell content-section" aria-labelledby="topics-heading">
    <div class="section-head">
      <div>
        <div class="section-kicker">Index</div>
        <h2 id="topics-heading">主题索引</h2>
      </div>
      <a class="section-link" href="/tags/">查看全部 →</a>
    </div>
    <div class="tag-grid">
      {[...tags].map(([tag, count]) => (
        <a class="tag-tile" href={tagHref(tag)}>
          <strong>#{tag}</strong>
          <span>{String(count).padStart(2, "0")} 篇文章</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="页面未找到" description="这个页面不存在或已经移动。">
  <section class="not-found" data-pagefind-ignore>
    <div class="error-code">ERROR / 404</div>
    <h1>页面不在这里。</h1>
    <p>它可能已经移动，或者链接里藏着一个小小的拼写错误。</p>
    <p><a href="/">← 返回文章首页</a></p>
  </section>
</BaseLayout>

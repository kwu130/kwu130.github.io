---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="搜索" description="搜索 Wukai’s Lab 的全部文章。">
  <link slot="head" href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <section class="search-page" data-pagefind-ignore>
    <div class="section-kicker">Search</div>
    <h1>搜索文章</h1>
    <p>搜索标题、正文和标签。按 <kbd>/</kbd> 可以从任意页面直接进入搜索。</p>
    <div class="search-panel">
      <div id="search"></div>
      <p id="search-status" role="status">正在准备搜索索引…</p>
    </div>
  </section>
  <script is:inline>
    (async () => {
      const status = document.querySelector("#search-status");
      try {
        if (!window.PagefindUI) {
          await new Promise((resolve, reject) => {
            const script = document.createElement("script");
            script.src = "/pagefind/pagefind-ui.js";
            script.onload = resolve;
            script.onerror = reject;
            document.head.appendChild(script);
          });
        }
        new window.PagefindUI({
          element: "#search",
          showSubResults: true,
          showImages: false,
          resetStyles: false,
          translations: {
            placeholder: "输入关键词…",
            zero_results: "没有找到 [SEARCH_TERM] 的相关结果",
            many_results: "找到 [COUNT] 条结果",
            one_result: "找到 1 条结果",
            clear_search: "清除"
          }
        });
        status?.remove();
        if (new URLSearchParams(window.location.search).has("focus")) {
          requestAnimationFrame(() => document.querySelector(".pagefind-ui__search-input")?.focus());
        }
      } catch {
        if (status) status.textContent = "搜索索引将在生产构建后可用。";
      }
    })();
  </script>
</BaseLayout>
